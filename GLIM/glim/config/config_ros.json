{
  /*** ROS-related config ***/
  // --- Backend modules ---
  // If both local and global mapping are disabled, odometry estimation runs.
  // enable_local_mapping   : Enable local mapping module
  // enable_global_mapping  : Enable global mapping module
  //
  // --- Points config ---
  // keep_raw_points        : Keep raw points in the map (required for only extension modules)
  //
  // --- IMU config ---
  // imu_time_offset        : Time offset for IMU data (in seconds)
  // acc_scale              : Accelerometer scale factor (Set to 9.80665 for Livox sensors)
  //
  // --- TF config ---
  // GLIM publishes TF subtrees "map -> odom -> base_frame" and "imu -> lidar".
  // imu_frame_id           : IMU frame ID (If blank, auto-detected from IMU topic)
  // lidar_frame_id         : LiDAR frame ID (If blank, auto-detected from points topic)
  // base_frame_id          : Base frame ID. If blank, IMU frame ID is used.
  // odom_frame_id          : Odometry frame ID
  // map_frame_id           : Map frame ID
  // publish_imu2lidar      : If false, do not publish "imu -> lidar" TF
  // tf_time_offset         : Time offset for TF data (in seconds)
  //
  // --- Extension modules ---
  // extension_modules      : List of extension modules to load
  //
  // --- Topics ---
  // imu_topic              : IMU topic
  // points_topic           : Points topic
  // image_topic            : Image topic (required for only extension modules)
  //
  // --- QoS options ---
  // imu_qos                : QoS options for IMU topic subscription.
  //   profile              : Builtin QoS profile name. Could be one of the following:
  //                          default, system_default, sensor_data, services_default, parameters, parameter_events
  //   depth                : Size of the message queue.
  //   durability           : Durability QoS policy setting. Could be one of the following:
  //                          system_default, transient_local, volatile
  //   reliability          : Reliabiilty QoS policy setting. Could be one of the following:
  //                          system_default, reliable, best_effort
  //   history              : History QoS policy setting. Could be one of the following:
  //                          system_default, keep_last, keep_all
  // points_qos             : QoS options for points topic subscription. See imu_qos for details.
  // image_qos              : QoS options for image topic subscription. See imu_qos for details.
  "glim_ros": {
    // Backend modules
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    // Points config
    "keep_raw_points": false,
    // IMU config
    "imu_time_offset": 0.00,
    "points_time_offset": 0.0,
    "acc_scale": 0.0, // Auto-detect if zero
    // TF config
    "imu_frame_id": "", // Auto-detect from /gps_p1/imu header (= gps_antenna_top; Atlas firmware projects IMU to antenna phase centre)
    "lidar_frame_id": "", // Auto-detect if blank
    "base_frame_id": "", // If blank, IMU frame ID is used
    "odom_frame_id": "odom",
    "map_frame_id": "map",
    "publish_imu2lidar": true,
    "tf_time_offset": 1e-6,
    // Extension modules.
    // libgnss_global.so adds GNSS-position factors to the iSAM2 global graph
    // whenever a usable RTK-FIXED sample arrives on the gnss topic configured
    // in config_gnss_global.json. With the current INS-driven odometry config,
    // the same RTK-fixed stream also supplies the primary trajectory, so GLIM
    // pauses where that stream has gaps. If config_odometry_gpu/cpu/ct is
    // selected instead, the GNSS factor stream becomes a sparse global anchor
    // while LiDAR+IMU odometry continues through dropouts.
    // Viewer modules (libstandard_viewer.so, librviz_viewer.so) are disabled
    // for unattended offline mapping runs; re-add them when you want the live
    // 3D view during mapping. They are not required for map/dump output.
    "extension_modules": [
      "libmemory_monitor.so",
      "libimu_validator.so",
      "libgnss_global.so"
    ],
    // Topics
    // Atlas FusionEngine imu_calibrated: sensor-level bias/scale/misalignment
    // removed by P1 firmware, gravity present, no fused orientation, 99 Hz.
    // See gicp_localization/cfg/localization.yaml for the rationale.
    "imu_topic": "/gps_p1/imu",
    "points_topic": "/luminar_front/points",
    "image_topic": "/image",
    // External INS / GNSS-aided odometry. Consumed by the current
    // libodometry_estimation_ins.so selection in config.json. If switching to
    // LiDAR+IMU odometry, this topic becomes unused by odometry; GNSS then
    // enters through libgnss_global.so via config_gnss_global.json.
    "external_odom_topic": "/gps_p1/filtered_odom_rtk_fixed",
    "external_odom_qos": {
      "profile": "default",
      "depth": 100
    },
    // QoS options
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "sensor_data",
      "reliability": "best_effort"
    },
    "image_qos": {
      "profile": "sensor_data"
    }
  }
}
