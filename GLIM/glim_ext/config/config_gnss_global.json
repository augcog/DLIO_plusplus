{
  "gnss": {
    // RTK-FIXED-only filtered stream from
    // gicp_localization/scripts/rtk_fixed_odom_filter.py. Each message that
    // lands here turns into a GNSS-position factor on the corresponding
    // pose in the global iSAM2 graph. During GNSS-denied passages the
    // filter stops forwarding -- no factors are added -- and the LiDAR+IMU
    // odometry alone drives the trajectory until RTK reacquires. The next
    // arriving message anchors the post-dropout trajectory back to the
    // global frame and iSAM2 retroactively smooths the trajectory.
    "gnss_topic": "/gps_p1/filtered_odom_rtk_fixed",
    "gnss_msg_type": "nav_msgs/msg/Odometry",
    "min_baseline": 5.0,
    // Preserve the legacy all-history world/GNSS initialization in shared
    // config. The generated high-quality profile enables a compact recent
    // suffix that rejects stationary/low-speed startup transients while still
    // requiring min_baseline on both the estimate and GNSS trajectories.
    "fit_recent_baseline_window": false,
    // The one-shot planar alignment must have enough geometry to estimate yaw
    // robustly, then predict samples it did not fit. The newest
    // fit_validation_samples are held out; both training and validation RMS
    // must pass fit_max_rms before the transform can latch.
    "fit_min_samples": 20,
    "fit_validation_samples": 10,
    // Site-independent compatibility default. Generated deployment profiles
    // may tighten this after measuring their GNSS/trajectory noise.
    "fit_max_rms": 2.0,
    // Atlas attitude (dual-antenna HEADING) prior on each submap. Position
    // anchoring (prior_inf_scale) pins WHERE a submap is, but not its yaw --
    // the Atlas dual-antenna heading is a drift-free reference that LiDAR+IMU
    // odometry lacks (slow yaw drift on feature-poor straights). With
    // orientation_prior_inf_scale = [1e-6, 1e-6, 1e2] this constrains YAW only
    // (~5.7 deg sigma) and leaves roll/pitch to gravity/LiDAR. This supersedes
    // porting a separate INS attitude module -- it is the same PoseRotationPrior
    // on X(submap), reusing the already-correct T_world_utm mapping and the
    // lever-arm handling below. VALIDATE the yaw convention on a real bag before
    // tightening the yaw precision (a wrong sign would twist the map; the loose
    // default is safe). NOTE: this fires only on RTK-FIXED samples (the
    // gnss_topic is the FIXED-filtered stream) -- see README for the FLOAT
    // extension if you also want heading held through RTK-FLOAT dropouts.
    "enable_orientation_prior": true,
    // Precisions (1/variance per axis) consumed by
    // gtsam::noiseModel::Diagonal::Precisions().  Reminder: precision is
    // information, NOT sigma -- higher = tighter constraint.  Equivalent
    // sigma per axis is sigma = 1 / sqrt(precision).
    //
    // Sized for Atlas RTK-FIXED input (pre-filtered by
    // rtk_fixed_odom_filter.py).  Measured on AV-24 run_2:
    //   cov_xx median 2.8e-5 m^2 (sigma ~5 mm); p95 4.1e-5 (~6 mm)
    //   cov_yy median 4.2e-5 m^2 (sigma ~6 mm); p95 5.7e-5 (~8 mm)
    //   cov_zz median 1.0e-4 m^2 (sigma ~1 cm); p95 1.3e-4 (~1.1 cm)
    //
    // Defaults below sit ~2-3x looser than Atlas's reported precision --
    // leaves headroom for transient multipath / firmware-INS spikes that
    // covariance doesn't capture, while still being stiff enough to
    // anchor the LiDAR+IMU trajectory through GNSS-denied passages.
    //
    //   prior_inf_scale[0]=1e4  -> sigma_x ~ 1 cm
    //   prior_inf_scale[1]=1e4  -> sigma_y ~ 1 cm
    //   prior_inf_scale[2]=1e3  -> sigma_z ~ 3 cm  (GPS Z naturally looser)
    //
    // Loosen (smaller values) if you see Atlas GNSS factors pulling the
    // trajectory away from LiDAR consistency during tracking; tighten
    // (larger values) if loop closures show residual drift through
    // dropouts (the GNSS anchor at dropout exit isn't being trusted
    // enough to absorb the IMU/LiDAR drift).
    "prior_inf_scale": [
      1e4,
      1e4,
      1e3
    ],
    // Optional covariance-aware position precision =
    // clamp(1 / variance, floor, cap). Negative vectors preserve the legacy
    // fixed prior_inf_scale behavior. The generated high-quality mapping
    // profile enables the proven floor/cap values per run.
    "prior_inf_floor": [
      -1.0,
      -1.0,
      -1.0
    ],
    "prior_inf_cap": [
      -1.0,
      -1.0,
      -1.0
    ],
    // Huber width in normalized residual units; <= 0 disables robust wrapping.
    "position_prior_robust_width": 0.0,
    // Rolling optimized GNSS-anchor rejection gate; <= 0 disables it. The
    // residual is measured after the global iSAM2 update, not against the raw
    // LIO pose before the GNSS factor has been applied. The run-local
    // high-quality profile enables this only with its matching GNSS contract.
    "anchor_abort_median_m": 0.0,
    "anchor_residual_window": 100,
    "anchor_residual_min_samples": 20,
    // Require this many consecutive optimized global updates above the same
    // median threshold before latching failure. One preserves the historical
    // fail-fast behavior; run-local profiles can tolerate a short iSAM2
    // convergence transient without relaxing anchor_abort_median_m.
    "anchor_abort_consecutive_updates": 1,
    "orientation_prior_inf_scale": [
      1e-6,
      1e-6,
      1e2
    ],
    // Optional gravity-direction prior from the GNSS/INS orientation. This
    // constrains body Z (roll/pitch) without constraining yaw. The value is the
    // 1-sigma angular uncertainty in degrees; <= 0 disables it. Keep disabled
    // in shared config because some generic pose publishers use an identity
    // quaternion as an "orientation unavailable" placeholder. A run-local
    // profile may enable it only for a validated fused-INS orientation stream.
    "gravity_prior_sigma_deg": 0.0,
    // P5#1 yaw-quality gate. The RTK filter feeding gnss_topic qualifies
    // POSITION quality only; the dual-antenna HEADING can be degraded or
    // unsolved while position stays RTK-FIXED (secondary-antenna outage,
    // baseline multipath). Skip the heading prior when the message's reported
    // yaw sigma (sqrt of pose.covariance[35], populated by the adapter from
    // Atlas rpy_covariance in deg^2 -> rad^2) exceeds this threshold; the
    // position prior is still applied. Atlas dual-antenna heading is
    // ~0.1-0.3 deg sigma when healthy, >1 deg degraded — 3.0 sits well clear
    // of healthy while rejecting garbage that a 5.7-deg-sigma prior would
    // otherwise ingest. <= 0 disables the gate; samples without populated
    // yaw covariance pass (covariance-less publishers keep old behavior).
    "orientation_prior_max_yaw_sigma_deg": 3.0,
    // [P1 FIX 2026-07-09] Max GNSS bracket width (seconds) for submap
    // association. Submaps whose bracketing samples are further apart than
    // this (i.e., inside an RTK dropout) are left UN-ANCHORED instead of
    // being pinned to a straight-line chord between dropout entry and exit.
    // Healthy filtered-odom output is ~10 Hz+, so 1.0 s passes normal
    // operation with wide margin and blocks every real dropout. <= 0
    // restores the legacy (chord-interpolating) behavior.
    "max_interp_gap_sec": 1.0,
    // Software antenna -> IMU lever-arm compensation.
    //
    // Set to FALSE for tightly-coupled INS receivers (Point One Atlas,
    // Novatel SPAN, Septentrio AsteRx-i, etc.) where the firmware already
    // resolves antenna observations to a common chassis reference internally.
    // Applying the correction here as well would double-compensate.
    //
    // Set to TRUE only for raw-GNSS publishers that report antenna-frame
    // position. The lever arm is then read from the URDF using
    // urdf_gnss_frame below.
    //
    // Current vehicle (AV-24, Point One Atlas): Atlas FusionEngine outputs
    // the INS pose/position at the primary antenna phase centre, so the
    // gnss_topic message's position is ALREADY at gps_antenna_top. Our
    // mapping graph body runs in the same frame (urdf_imu_frame =
    // "gps_antenna_top"), so this position lever-arm is zero. Leave false.
    // (The IMU stream is body-axis-rotated but device-located per FusionEngine
    // Spec 3.4.1 -- a separate, small accel lever-arm, not this one.)
    "enable_lever_arm": false,
    // URDF link name of the GNSS antenna. Only consulted when
    // enable_lever_arm is true. Empty string means "no lever arm".
    // Examples: "gps_antenna_top", "gps_antenna_front".
    "urdf_gnss_frame": ""
  }
}
