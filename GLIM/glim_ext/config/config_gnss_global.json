{
  "gnss": {
    // RTK-FIXED-only filtered stream from
    // gicp_localization/scripts/rtk_fixed_odom_filter.py. Each message that
    // lands here turns into a GNSS-position factor on the corresponding
    // pose in the global iSAM2 graph. With the current INS-driven odometry
    // config, this same stream supplies the primary mapping trajectory, so
    // GLIM pauses where the stream has gaps. If config_odometry_gpu/cpu/ct
    // is selected instead, LiDAR+IMU odometry continues through dropouts and
    // this stream becomes a sparse global anchor when RTK reacquires.
    "gnss_topic": "/gps_p1/filtered_odom_rtk_fixed",
    "gnss_msg_type": "nav_msgs/msg/Odometry",
    "min_baseline": 5.0,
    "enable_orientation_prior": false,
    // Precisions (1/variance per axis) consumed by
    // gtsam::noiseModel::Diagonal::Precisions().  Reminder: precision is
    // information, NOT sigma -- higher = tighter constraint.  Equivalent
    // sigma per axis is sigma = 1 / sqrt(precision).
    //
    // Sized for Atlas RTK-FIXED input (pre-filtered by
    // rtk_fixed_odom_filter.py).  Measured on AV-24 run_2:
    //   cov_xx median 2.8e-5 m^2 (sigma ~5 mm); p95 4.1e-5 (~6 mm)
    //   cov_yy median 4.2e-5 m^2 (sigma ~6 mm); p95 5.7e-5 (~8 mm)
    //   cov_zz median 1.0e-4 m^2 (sigma ~1 cm); p95 1.3e-4 (~1.1 cm)
    //
    // Current values intentionally pin RTK-clean INS-driven maps tightly to
    // Atlas. If you switch to LiDAR+IMU odometry and see GNSS factors fight
    // LiDAR consistency, loosen these values.
    //
    //   prior_inf_scale[0]=1e6  -> sigma_x ~ 1 mm
    //   prior_inf_scale[1]=1e6  -> sigma_y ~ 1 mm
    //   prior_inf_scale[2]=1e5  -> sigma_z ~ 3 mm  (GPS Z naturally looser)
    //
    // Raised from (1e4,1e4,1e3): with the INS-driven odometry the VGICP
    // registration factors (thousands of correspondences per submap pair)
    // were still able to bend the trajectory up to ~4 m away from the
    // RTK-fixed track on feature-ambiguous sections of the Putnam runs.
    // The rtk_fixed stream is cm-accurate, so pin the submaps hard.
    "prior_inf_scale": [
      1e6,
      1e6,
      1e5
    ],
    "orientation_prior_inf_scale": [
      1e-6,
      1e-6,
      1e2
    ],
    // Software antenna -> IMU lever-arm compensation.
    //
    // Set to FALSE for tightly-coupled INS receivers (Point One Atlas,
    // Novatel SPAN, Septentrio AsteRx-i, etc.) where the firmware already
    // resolves antenna observations to a common chassis reference internally.
    // Applying the correction here as well would double-compensate.
    //
    // Set to TRUE only for raw-GNSS publishers that report antenna-frame
    // position. The lever arm is then read from the URDF using
    // urdf_gnss_frame below.
    //
    // Current vehicle (AV-24, Point One Atlas): Atlas FusionEngine projects
    // both IMU and INS pose to the primary antenna phase centre internally,
    // so the gnss_topic message's position is ALREADY at gps_antenna_top.
    // The current INS-driven map-building path and optional LiDAR+IMU modes
    // use the same Atlas-projected frame, so the relative correction is
    // zero. Leave false.
    "enable_lever_arm": false,
    // URDF link name of the GNSS antenna. Only consulted when
    // enable_lever_arm is true. Empty string means "no lever arm".
    // Examples: "gps_antenna_top", "gps_antenna_front".
    "urdf_gnss_frame": ""
  }
}
