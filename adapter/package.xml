<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adapter</name>
  <version>0.0.1</version>
  <description>Online adapter from Atlas and optional P1 IMU PCAP to the normalized GLIM/GICP input contract.</description>
  <maintainer email="bryan.chang@berkeley.edu">Bryan Chang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>fusion_engine_msgs</depend>
  <depend>eigen</depend>
  <depend>geographiclib</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
