# DLIO++ local pipeline configuration.
#
# Copy this file to `dlio.env` in the repository root and edit it for
# your workstation. `dlio.env` is git-ignored so machine-specific data
# paths do not leak into commits.
#
# Usage after editing:
#   scripts/run_dlio_pipeline.sh
#
# CLI flags still override values from this file.

# Optional race_common overlay. Required for building/running the live adapter
# because FusionEngine message definitions live there.
# Example:
#   DLIO_RACE_COMMON_SETUP="/path/to/race_common/install/setup.bash"
DLIO_RACE_COMMON_SETUP=""

# Directory that contains the dataset tree, for example:
#   $DLIO_ROSBAG_ROOT/putnam/may_26/run_5/filtered/all
DLIO_ROSBAG_ROOT="/path/to/rosbags"

# Output root for generated prepped bags, dumps, maps, localization logs, and
# evaluation artifacts.
DLIO_DATA_ROOT="./dlio_data"

# Logical run name. If DLIO_RAW is blank, the wrapper derives the default raw
# bag path as:
#   $DLIO_ROSBAG_ROOT/putnam/may_26/$DLIO_RUN/filtered/all
DLIO_RUN="run_5"

# Optional explicit raw bag path. Set this when your dataset is not laid out as
# the Putnam examples above.
DLIO_RAW=""

# Optional existing prepared bag. Set this instead of DLIO_RAW to skip prep.
DLIO_PREPPED=""

# Optional map/origin reuse.
# For example, set DLIO_RUN="run_3", DLIO_ORIGIN_RUN="run_5", and
# DLIO_MAP_RUN="run_5" to prep run_3 with run_5's UTM origin and localize
# against run_5's map.
DLIO_ORIGIN_RUN=""
DLIO_UTM_ORIGIN_FILE=""
DLIO_MAP_RUN=""

# Pass `true` to open RViz during localization replay.
DLIO_RVIZ="false"

# Live/raw adapter options. The default adapter inputs expect raw Luminar
# topics remapped from /luminar_* into /dlio_raw/luminar_* so adapter outputs
# can safely use the normalized /luminar_* names.
DLIO_USE_ADAPTER="false"
DLIO_ADAPTER_IMU_STAMP_MODE="auto"
DLIO_ADAPTER_IMU_LOOKAHEAD="16"
# QoS depth 0 maps to DDS keep_all; use only for bounded offline equivalence gates.
DLIO_ADAPTER_POSE_RELIABILITY="reliable"
DLIO_ADAPTER_POSE_QOS_DEPTH="100"
DLIO_ADAPTER_IMU_RELIABILITY="best_effort"
DLIO_ADAPTER_IMU_QOS_DEPTH="100"
# Optional Point One INS PCAP. When set in raw-live mode, IMU_OUTPUT is decoded
# online from this PCAP and the raw bag's /atlas/imu_calibrated topic is not
# replayed.
DLIO_ADAPTER_IMU_P1_PCAP=""
DLIO_ADAPTER_PLAY_RATE=""
DLIO_ADAPTER_PLAY_DELAY="5"
DLIO_ADAPTER_LIDAR_RELIABILITY="best_effort"
DLIO_ADAPTER_LIDAR_QOS_DEPTH="5"
DLIO_BAG_QOS_OVERRIDES=""
DLIO_ADAPTER_UTM_ORIGIN=""
DLIO_ADAPTER_T_WORLD_UTM=""

# Online localization GT safety-net tuning. The conservative defaults match
# localization.yaml; for GNSS-primary online replay, set 1 and 1.0.
DLIO_GT_RECOVERY_MIN_CONSECUTIVE_FAILURES="4"
DLIO_GT_VETO_DIST="3.0"

# Pass `true` to validate paths and output choices without starting ROS replay.
DLIO_DRY_RUN="false"
